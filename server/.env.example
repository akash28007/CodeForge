# Database
# Local dev uses this directly. In production (Neon), Neon gives you a ready-made
# connection string in this same DATABASE_URL format — just paste theirs in.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codeforge?schema=public"

# Redis / Queue
# Local dev (docker-compose Redis, no auth/TLS) uses REDIS_HOST/REDIS_PORT.
# Hosted Redis (Upstash) instead uses a single REDIS_URL — if set, it takes
# priority over REDIS_HOST/REDIS_PORT. Format: rediss://default:<password>@<host>:<port>
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=rediss://default:xxxxx@your-instance.upstash.io:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=4000
NODE_ENV=development
# Restricts CORS to your deployed frontend in production. Leave unset locally
# (falls back to allowing any origin, which is what local Vite dev needs).
# CLIENT_URL=https://your-app.vercel.app

# Execution sandbox
EXEC_CPU_LIMIT=1
EXEC_MEMORY_LIMIT_MB=256
EXEC_TIMEOUT_MS=5000
EXEC_QUEUE_CONCURRENCY=4

# Uploads
# Where admin-uploaded images (hero art, logos, thumbnails) are written. Relative
# paths resolve from the process working directory; defaults to server/uploads.
# On the deployment VM point this at a path on the persistent disk.
UPLOAD_DIR=./uploads
